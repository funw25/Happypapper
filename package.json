{
  "name": "happypaper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db-seed.mjs",
    "db:reset": "node --env-file-if-exists=.env.local scripts/db-reset.mjs",
    "verify:smoke": "node scripts/smoke.mjs",
    "verify:notify": "node scripts/verify-notify.mjs",
    "verify:github": "node scripts/verify-github.mjs",
    "verify:github-schema": "node scripts/verify-github-schema.mjs",
    "verify:anchor": "node scripts/verify-anchor.mjs",
    "verify:search": "node scripts/verify-search.mjs",
    "verify:search-fallback": "node scripts/verify-search-fallback.mjs",
    "verify:search-ui": "node scripts/verify-search-ui.mjs",
    "verify:settings": "node scripts/verify-settings.mjs",
    "verify:theme": "node scripts/verify-theme.mjs",
    "verify:reader": "node scripts/verify-reader.mjs",
    "pdf:worker": "node scripts/copy-pdf-worker.mjs"
