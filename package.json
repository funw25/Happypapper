    "next": "^16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
